#!/usr/bin/env bash
set -euo pipefail

AUTHORIZED_KEYS=/root/.ssh/authorized_keys
DATA_BASE=/var/lib/root-ide

die() {
    echo "root-ide-list: $*" >&2
    exit 1
}

is_managed_line() {
    [[ "$1" == 'environment="ROOT_IDE_USER='*'",command="/usr/local/libexec/root-ide-ssh" '* ]]
}

parse_managed_line() {
    local rest=${1#environment=\"ROOT_IDE_USER=}

    MANAGED_USER=${rest%%\"*}

    rest=${1#* }
    MANAGED_TYPE=${rest%%[[:space:]]*}
    rest=${rest#"$MANAGED_TYPE"}
    rest=${rest#"${rest%%[![:space:]]*}"}
    MANAGED_DATA=${rest%%[[:space:]]*}
    MANAGED_COMMENT=${rest#"$MANAGED_DATA"}
    MANAGED_COMMENT=${MANAGED_COMMENT#"${MANAGED_COMMENT%%[![:space:]]*}"}
}

main() {
    local line

    [[ $EUID -eq 0 ]] || die "run as root"

    printf '%-20s %-40s %-28s %s\n' \
        NAME DATA_DIR KEY_TYPE COMMENT
    printf '%-20s %-40s %-28s %s\n' \
        ---- -------- -------- -------

    if [[ -L "$AUTHORIZED_KEYS" ]]; then
        die "refusing to read symlink: $AUTHORIZED_KEYS"
    fi

    [[ -f "$AUTHORIZED_KEYS" ]] || exit 0

    while IFS= read -r line || [[ -n "$line" ]]; do
        is_managed_line "$line" || continue

        parse_managed_line "$line"

        [[ "$MANAGED_USER" =~ ^[A-Za-z0-9_-]+$ ]] || continue
        [[ -n "$MANAGED_TYPE" && -n "$MANAGED_DATA" ]] || continue

        printf '%-20s %-40s %-28s %s\n' \
            "$MANAGED_USER" \
            "$DATA_BASE/$MANAGED_USER" \
            "$MANAGED_TYPE" \
            "$MANAGED_COMMENT"
    done < "$AUTHORIZED_KEYS"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
